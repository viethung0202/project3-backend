model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String
  phone     String?
  avatar    String?
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  createdCourses    Course[]           @relation("CourseCreator") // giáo vụ tạo
  teachingCourses   CourseTeacher[] // giáo viên dạy
  enrollments       Enrollment[] // học sinh enroll
  quizAttempts      QuizAttempt[] // học sinh làm quiz
  createdTests      Test[] // giáo vụ tạo full test / mini test
  testAttempts      TestAttempt[] // học sinh làm test online
  lessonCompletions LessonCompletion[] // học sinh hoàn thành lesson
  uploadedDocuments Document[] // giáo vụ upload tài liệu
  passwordResets    PasswordResetToken[] // token đặt lại mật khẩu
  certificates      Certificate[] // chứng chỉ đã nhận
  evaluations       StudentEvaluation[] @relation("EvaluationStudent") // đánh giá của bản thân (nếu là học sinh)
  evaluationsGiven  StudentEvaluation[] @relation("EvaluationTeacher") // đánh giá đã cho (nếu là giáo viên)

  @@map("users")
}

enum EvaluationGrade {
  EXCELLENT
  GOOD
  AVERAGE
  FAIR
  POOR
}

model StudentEvaluation {
  id            String          @id @default(uuid())
  studentId     String
  courseId      String
  evaluatedById String // teacher
  overallGrade  EvaluationGrade
  listeningScore Float? // 0-100
  speakingScore  Float?
  readingScore   Float?
  writingScore   Float?
  strengths      String? // điểm mạnh
  weaknesses     String? // điểm yếu
  recommendation String? // lời khuyên
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student     User   @relation("EvaluationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  evaluatedBy User   @relation("EvaluationTeacher", fields: [evaluatedById], references: [id])

  @@unique([studentId, courseId])
  @@index([courseId])
  @@map("student_evaluations")
}

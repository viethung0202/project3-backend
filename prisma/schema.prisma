// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  // previewFeatures = ["prismaSchemaFolder"]   // Chỉ cần nếu Prisma < 6.7.0
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Không cần khai báo datasource ở đây nữa vì đã chuyển sang prisma.config.js
// Các file khác sẽ được Prisma tự động load khi dùng multi-file schema

model Lesson {
    id        String   @id @default(uuid())
    moduleId  String
    title     String
    content   String? // nội dung dạng text (ghi chú ngắn)
    videoUrl  String? // DEPRECATED — giữ tạm cho legacy, dùng LessonDocument thay thế
    pdfUrl    String? // DEPRECATED — giữ tạm cho legacy, dùng LessonDocument thay thế
    order     Int // thứ tự lesson trong module
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    module      Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
    completions LessonCompletion[]
    documents   LessonDocument[]

    @@map("lessons")
}

// Bảng nối lesson - document (many-to-many)
model LessonDocument {
    id         String   @id @default(uuid())
    lessonId   String
    documentId String
    order      Int      @default(0) // thứ tự hiển thị trong lesson
    createdAt  DateTime @default(now())

    lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
    document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

    @@unique([lessonId, documentId])
    @@map("lesson_documents")
}

// Đánh dấu học sinh đã hoàn thành lesson nào — dùng để tính progress của course
model LessonCompletion {
    id          String   @id @default(uuid())
    lessonId    String
    studentId   String
    completedAt DateTime @default(now())

    lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
    student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

    @@unique([lessonId, studentId])
    @@map("lesson_completions")
}

model Lesson {
    id        String   @id @default(uuid())
    moduleId  String
    title     String
    content   String? // nội dung dạng text/HTML
    videoUrl  String? // link video (nếu có)
    order     Int // thứ tự lesson trong module
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    module      Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
    completions LessonCompletion[]

    @@map("lessons")
}

// Đánh dấu học sinh đã hoàn thành lesson nào — dùng để tính progress của course
model LessonCompletion {
    id          String   @id @default(uuid())
    lessonId    String
    studentId   String
    completedAt DateTime @default(now())

    lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
    student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

    @@unique([lessonId, studentId])
    @@map("lesson_completions")
}
